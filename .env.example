# Dormdash environment variables.
# Local dev needs NONE of these: with nothing set, the app runs on an in-process
# Postgres (PGlite, in .data/), local auth, local file storage, demo payments,
# and emails go to the dev outbox at /dev/outbox.
#
# Copy to .env.local for local overrides. On Vercel, paste these into
# Project Settings > Environment Variables. See README "Go live".

# ---------- Site ----------
# Public URL of the deployment (used in emails and auth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://dormdash.app
# Optional runtime override of the above (useful when one build serves several URLs).
SITE_URL=

# Random 32+ char string. Signs cookies and local file URLs. Generate: openssl rand -base64 32
APP_SECRET=

# Comma-separated email domains allowed to sign up.
ALLOWED_EMAIL_DOMAINS=nyu.edu

# Comma-separated emails that become admins automatically on signup/login.
ADMIN_EMAILS=you@nyu.edu

# ---------- Supabase (auth, database, storage, realtime) ----------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (or "publishable") key. Safe in the browser: RLS protects every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (or "secret") key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard > Connect > Transaction pooler (port 6543). Used by the server for SQL.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# ---------- Payments (see PAYMENTS.md) ----------
# "demo" (default: no money moves, everything else works) or "paypal".
PAYMENTS_PROVIDER=demo
# "sandbox" while testing, "live" for real money.
PAYPAL_ENV=sandbox
# developer.paypal.com > Apps & Credentials > your app
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# developer.paypal.com > your app > Webhooks > the webhook's ID
PAYPAL_WEBHOOK_ID=

# ---------- Email (transactional: runner decisions, dispute outcomes, notifications) ----------
# resend.com > API Keys. Without it, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Dormdash <hello@dormdash.app>

# ---------- Web push ----------
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@dormdash.app

# ---------- Cron ----------
# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---------- Local only ----------
# PGLITE_DIR=.data/pglite
# LOCAL_STORAGE_DIR=.data/storage
# DEV_TOOLS=1   # enables /dev/outbox on a production build running locally (never on Vercel)
